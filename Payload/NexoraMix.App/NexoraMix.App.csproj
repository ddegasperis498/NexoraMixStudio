<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NexoraMix</AssemblyName>
    <RootNamespace>NexoraMix.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.3.0</Version>
    <AssemblyVersion>5.3.0.0</AssemblyVersion>
    <FileVersion>5.3.0.0</FileVersion>
    <InformationalVersion>5.3.0-hybrid</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexoraMix.Core\NexoraMix.Core.csproj" />
    <ProjectReference Include="..\NexoraMix.Audio\NexoraMix.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\DemoAudio\*.wav" Link="DemoAudio\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
