<Window x:Class="NexoraMix.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora Mix"
        Width="780" Height="560"
        MinWidth="620" MinHeight="500"
        MaxWidth="1000" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Border Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,26,28,16">
                    <StackPanel>
                        <Border Width="48" Height="48" CornerRadius="13"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="↗" Foreground="#04130F" FontSize="23"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="TitleText" Margin="0,16,0,0"
                                   FontSize="25" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Margin="0,8,0,20"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14" LineHeight="22" TextWrapping="Wrap" />

                        <Border Background="#101827" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="COSA INSERIRE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="ExampleText" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="FieldLabelText" Text="VALORE"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="2,0,0,7" />
                        <TextBox x:Name="ValueTextBox" MinHeight="54"
                                 Padding="14,10" FontSize="15"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="NoWrap" />
                        <TextBlock Text="Il valore viene salvato localmente nell'applicazione."
                                   FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                   TextWrapping="Wrap" Margin="2,8,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer sempre visibile, anche con scaling Windows 150%. -->
                <Border Grid.Row="1" Background="#0B111B" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,1,0,0"
                        Padding="18,14" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ESC annulla · INVIO conferma" Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center" FontSize="12" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="ANNULLA" IsCancel="True" MinWidth="110" />
                            <Button Content="CONFERMA"
                                    Style="{StaticResource PrimaryButton}"
                                    IsDefault="True" Click="Confirm_Click"
                                    MinWidth="125" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
