<UserControl x:Class="NexoraMix.App.Views.MixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NexoraMix.App.Views"
             MinWidth="400">
    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MIXER 4 CANALI" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="A/C lato sinistro · B/D lato destro" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MasterPeakText}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ClippingText, StringFormat=CLIP {0}}" Foreground="{StaticResource WarningBrush}" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="OUT MASTER" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="230"
                          ItemsSource="{Binding AudioOutputDevices}"
                          SelectedItem="{Binding SelectedMasterOutputDevice, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Text="OUT CUFFIE" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" MinWidth="230"
                          ItemsSource="{Binding AudioOutputDevices}"
                          SelectedItem="{Binding SelectedCueOutputDevice, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Text="VOL CUE" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="8,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="1.5" Value="{Binding CueVolume, Mode=TwoWay}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{Binding MasterCueLabel}" Command="{Binding ToggleMasterCueCommand}" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="AGGIORNA" Command="{Binding RefreshAudioOutputsCommand}" Margin="0"/>
                </Grid>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="4" Margin="0,10,0,8">
                <views:ChannelStrip DataContext="{Binding DeckA}"/>
                <views:ChannelStrip DataContext="{Binding DeckB}"/>
                <views:ChannelStrip DataContext="{Binding DeckC}"/>
                <views:ChannelStrip DataContext="{Binding DeckD}"/>
            </UniformGrid>

            <Grid Grid.Row="3" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="A/C" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Crossfader, Mode=TwoWay}" Margin="12,0" ToolTip="Crossfader equal-power"/>
                <TextBlock Grid.Column="2" Text="B/D" Foreground="#9D86FF" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="4" Columns="4" Margin="0,10,0,0">
                <Button Content="CENTRA" Command="{Binding CenterCrossfaderCommand}"/>
                <Button Content="{Binding MashupButtonText}" Command="{Binding StartAutoMashupCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="{Binding RecordingButtonText}" Command="{Binding StartStopRecordingCommand}"/>
                <Button Content="STOP TUTTO" Command="{Binding StopAllCommand}" Style="{StaticResource DangerButton}"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
