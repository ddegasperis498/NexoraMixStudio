<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#070A10</Color>
    <Color x:Key="SurfaceColor">#0E1420</Color>
    <Color x:Key="SurfaceElevatedColor">#131B2A</Color>
    <Color x:Key="SurfaceAltColor">#182234</Color>
    <Color x:Key="StrokeColor">#26344A</Color>
    <Color x:Key="StrokeSoftColor">#1A2638</Color>
    <Color x:Key="TextColor">#F7FAFF</Color>
    <Color x:Key="MutedTextColor">#91A0B7</Color>
    <Color x:Key="SubtleTextColor">#68768D</Color>
    <Color x:Key="AccentColor">#19E6C4</Color>
    <Color x:Key="AccentHoverColor">#50F2D7</Color>
    <Color x:Key="DeckAColor">#20E4C1</Color>
    <Color x:Key="DeckBColor">#8B6CFF</Color>
    <Color x:Key="WarningColor">#FFBF5B</Color>
    <Color x:Key="DangerColor">#FF5B7D</Color>
    <Color x:Key="SuccessColor">#45D483</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="DeckABrush" Color="{StaticResource DeckAColor}" />
    <SolidColorBrush x:Key="DeckBBrush" Color="{StaticResource DeckBColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
</ResourceDictionary>
